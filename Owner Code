<!-- OWNER LOGIN -->
<div id="ownerLogin" style="
  position:fixed;
  inset:0;
  background:#10152b;
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:99999;
  font-family:Arial,sans-serif;
">
  <div style="
    background:#1c2545;
    padding:35px;
    border-radius:18px;
    text-align:center;
    color:white;
    width:300px;
  ">
    <h2>🔐 Owner Access</h2>
    <p>Yeeps Staff Hub</p>

    <input
      id="ownerPassword"
      type="password"
      placeholder="Enter password"
      style="padding:12px;width:90%;border-radius:8px;border:0;"
    >

    <button onclick="loginOwner()" style="
      margin-top:15px;
      padding:12px 25px;
      background:#477cff;
      color:white;
      border:0;
      border-radius:8px;
      cursor:pointer;
    ">Unlock</button>

    <p id="loginMessage"></p>
  </div>
</div>

<script>
function loginOwner() {
  const password = "LeafVault#M0dly_84Q!";

  if (document.getElementById("ownerPassword").value === password) {
    sessionStorage.setItem("isOwner", "true");
    document.getElementById("ownerLogin").style.display = "none";
  } else {
    document.getElementById("loginMessage").textContent =
      "Incorrect password!";
  }
}

if (sessionStorage.getItem("isOwner") === "true") {
  document.getElementById("ownerLogin").style.display = "none";
}
</script>
